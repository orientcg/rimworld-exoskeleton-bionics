<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef>
    <defName>EXB_CoreDamaged</defName>
    <label>exoskeleton core damaged</label>
    <description>The core has shut down after its armor was depleted. Limb bonuses, energy regeneration and overload are disabled for two in-game hours. It recovers automatically; metal armor remains empty until reloaded.</description>
    <hediffClass>ExoBionics.Hediff_ExoCoreDamaged</hediffClass>
    <isBad>true</isBad>
    <everCurableByItem>false</everCurableByItem>
    <allowMothballIfLowPriorityWorldPawn>false</allowMothballIfLowPriorityWorldPawn>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>5000</disappearsAfterTicks>
      </li>
    </comps>
  </HediffDef>
  <JobDef>
    <defName>EXB_AbsorbMetal</defName>
    <driverClass>ExoBionics.JobDriver_ExoAbsorbMetal</driverClass>
    <reportString>Absorbing metal for exoskeleton armor.</reportString>
    <casualInterruptible>false</casualInterruptible>
    <playerInterruptible>true</playerInterruptible>
  </JobDef>
</Defs>
